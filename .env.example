# x402 bot paywall (Vercel Routing Middleware: middleware.js)
# Set X402_ENABLED=false to disable the paywall entirely.
X402_ENABLED=true
X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
X402_PRICE=$0.001
# CAIP-2 network. eip155:8453 = Base mainnet (USDC); eip155:84532 = Base Sepolia (testnet)
X402_NETWORK=eip155:8453
# Coinbase CDP facilitator (required for Base mainnet). When both are set they take precedence.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Used only when CDP keys are not set. Note: x402.org only supports testnets.
X402_FACILITATOR_URL=https://x402.org/facilitator
